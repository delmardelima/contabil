  "documentos": [
    {
      "id": 1,
      "empresaId": 1,
      "titulo": "Notas Explicativas da Administração às Demonstrações Contábeis",
      "tipo": "NOTA_EXPLICATIVA",
      "exercicioAno": 2026,
      "conteudoHtml": "\n      <h2 style=\"text-align: center; font-size: 16pt; font-weight: bold; margin-bottom: 12pt;\">\n        {{empresa_razao_social}}<br>\n        <span style=\"font-size: 11pt; font-weight: normal;\">CNPJ nº {{empresa_cnpj}}</span>\n      </h2>\n      <h3 style=\"text-align: center; font-size: 13pt; font-weight: bold; margin-bottom: 24pt;\">\n        NOTAS EXPLICATIVAS ÀS DEMONSTRAÇÕES CONTÁBEIS<br>\n        EXERCÍCIO FINDO EM 31 DE DEZEMBRO DE {{exercicio_ano}}\n      </h3>\n      \n      <p style=\"font-weight: bold; margin-top: 14pt;\">1. CONTEXTO OPERACIONAL</p>\n      <p style=\"text-align: justify; line-height: 1.5; margin-bottom: 10pt;\">\n        A <strong>{{empresa_razao_social}}</strong> é uma sociedade empresária limitada com sede na cidade de São Paulo/SP, tendo por objeto social a prestação de serviços de tecnologia da informação, desenvolvimento e licenciamento de software e consultoria de auditoria contábil digital. As demonstrações contábeis foram elaboradas de acordo com as práticas contábeis adotadas no Brasil, consubstanciadas nas Normas Brasileiras de Contabilidade emitidas pelo Conselho Federal de Contabilidade (CFC / NBC TG 1000).\n      </p>\n\n      <p style=\"font-weight: bold; margin-top: 14pt;\">2. PRINCIPAIS DIRETRIZES CONTÁBEIS</p>\n      <p style=\"text-align: justify; line-height: 1.5; margin-bottom: 10pt;\">\n        <strong>a) Reconhecimento de Receitas e Despesas:</strong> O resultado é apurado estritamente pelo <em>Regime de Competência</em>. As receitas de prestação de serviços são reconhecidas no momento da execução dos serviços contratados.<br>\n        <strong>b) Caixa e Equivalentes de Caixa:</strong> O saldo em 31/12/{{exercicio_ano}} de <strong>{{saldo_caixa_total}}</strong> compreende recursos em caixa e contas bancárias de livre movimentação e liquidez imediata.\n      </p>\n\n      <p style=\"font-weight: bold; margin-top: 14pt;\">3. DEMONSTRAÇÕES SINTÉTICAS CONSOLIDADAS</p>\n      <div style=\"margin: 15pt 0; padding: 10pt; border: 1px solid #ccc; background: #fafafa;\">\n        {{tabela_balanco_sintetico}}\n      </div>\n\n      <p style=\"text-align: justify; line-height: 1.5; margin-top: 20pt;\">\n        São Paulo/SP, {{data_extenso_atual}}.<br><br>\n        __________________________________________<br>\n        <strong>{{contador_nome}}</strong><br>\n        Contador Responsável - {{contador_crc}}\n      </p>\n    ",
      "updatedAt": "2026-10-15T02:23:28.757Z"
    }
  ],
